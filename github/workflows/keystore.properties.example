# Release signing configuration for KAVACH 4.0 Voice Assistant
#
# HOW TO USE:
#   1. Generate a keystore (see README.md "Signing the release build").
#   2. Copy this file to "keystore.properties" in the project root.
#   3. Fill in the real values below.
#   4. keystore.properties is git-ignored — never commit it or your
#      keystore file. Losing this keystore means you can never publish
#      an update to the same Play Store listing again, so back it up
#      somewhere safe (outside of git).

storeFile=../kavach4-release.jks
storePassword=CHANGE_ME
keyAlias=kavach4
keyPassword=CHANGE_ME
